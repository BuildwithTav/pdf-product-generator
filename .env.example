# Supabase (new project — do not reuse Carousel Studio's project)
# Enable "Allow anonymous sign-ins" under Authentication > Settings —
# there's no login screen, every visitor gets a silent anonymous session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Supabase service role key — server-only, bypasses RLS. Used exclusively by
# the Stripe webhook, verify-payment, and redeem-code routes to write
# project_payments (customers can only ever read that table, never write it).
# Find it in Supabase: Project Settings > API > service_role key.
# NEVER expose this with a NEXT_PUBLIC_ prefix or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — $10 flat checkout per project, no subscriptions/bundles.
# Secret key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
# Webhook signing secret. In the Stripe dashboard, add an endpoint pointing
# at https://<your-domain>/api/stripe/webhook subscribed to the
# checkout.session.completed event, then copy its "Signing secret" here.
STRIPE_WEBHOOK_SECRET=

# Owner bypass — a secret of your own choosing (any random string). Visit
# /api/owner-unlock?token=<this-value> once from your own browser to set a
# long-lived cookie that skips the paywall entirely on that device, forever
# (no login, no DB row). Keep this value private.
OWNER_BYPASS_TOKEN=
