# Supabase (new project — do not reuse Carousel Studio's project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used to manage the member allowlist
# and to check it during login, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Pexels (free tier: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Used to build the magic-link redirect URL. Set to your deployed URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
